{
  "manifest_version": 3,
  "name": "Wine Queue · 买酒清单",
  "version": "0.1.0",
  "description": "一键收藏酒款，按酒商整理待购清单，达到设定的免运费门槛时提醒。",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "收藏这款酒", "default_icon": "icons/icon128.png"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
